# ==============================================================================
# Günay Kimya Chemical Manufacturing ERP - Environment Variables Template
# Copy this file to .env and replace placeholders with secure credentials.
# ==============================================================================

# Application Meta
PROJECT_NAME="Gunay Kimya ERP Backend"
ENVIRONMENT="production"
PORT=8000

# CORS Allowed Frontend Origin (Production URL e.g. https://gunay-kimya-web.onrender.com)
FRONTEND_URL=https://gunay-kimya-web.onrender.com

# PostgreSQL Connection (Render Managed Postgres, Neon, Supabase or local)
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
# Note: In local development, leave blank or use: sqlite+aiosqlite:///./app.db
DATABASE_URL=postgresql+asyncpg://gunay_user:your_secure_password_here@dpg-sample.render.com/gunay_kimya_erp

# Security & JWT Configuration
# Generate a cryptographically secure key: openssl rand -hex 32
SECRET_KEY=replace_with_a_64_character_hex_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Initial Admin Password for First Boot Seed Data
ADMIN_PASSWORD=your_initial_admin_password_here

# API Routing
API_V1_STR=/api/v1
